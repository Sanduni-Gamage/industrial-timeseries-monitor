# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every value here has a safe default in ingestion/config.py; this file exists
# so a reviewer can see what is configurable without reading the code.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Named instance example: localhost\SQLEXPRESS01
# Default instance example: localhost
DB_SERVER=localhost\SQLEXPRESS01
DB_DATABASE=IndustrialMonitor
DB_DRIVER=ODBC Driver 18 for SQL Server

# Windows authentication (recommended for local development).
# When true, DB_USERNAME / DB_PASSWORD are ignored and no credential is stored.
DB_TRUSTED_CONNECTION=true

# SQL authentication - only used when DB_TRUSTED_CONNECTION=false.
# Leave blank in the committed example. Never put a real password in .env.example.
DB_USERNAME=
DB_PASSWORD=

# Driver 18 defaults to Encrypt=yes and will reject a self-signed local
# certificate. Keep true for local development; set false against a server
# with a trusted certificate.
DB_TRUST_SERVER_CERTIFICATE=true

DB_CONNECT_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=600

# --- Data source ----------------------------------------------------------
# Relative paths resolve against the repository root. See data/README.md.
METROPT_RAW_CSV=data/raw/MetroPT3(AirCompressor).csv

# --- Ingestion tuning -----------------------------------------------------
# Source rows per chunk. Each source row expands to 15 reading rows, so 50000
# here means 750000 rows per database round trip batch.
INGEST_CHUNK_ROWS=50000

# Rows per executemany batch sent to SQL Server.
INGEST_BATCH_ROWS=50000

# --- Data quality thresholds ---------------------------------------------
# Every value below is derived from docs/DATA_PROFILE.md, not guessed.
# See docs/SQL_DESIGN.md section 6 for the measurement behind each one.

# 3x the measured modal sampling interval of 10 s. Absorbs the observed
# +/-1-3 s logger jitter; anything larger is a real dropout.
GAP_THRESHOLD_SECONDS=30

# Consecutive identical scans that count as a data-acquisition freeze.
# 6 samples = 60 s, longer than any genuine plateau in this signal.
FLATLINE_MIN_SAMPLES=6

# |Reservoirs - TP3| above this is instrument failure, not noise.
# Largest divergence ever observed in the file is 0.182 bar.
XSENSOR_DIVERGENCE_BAR=0.5

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- API (Phase 4) --------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
